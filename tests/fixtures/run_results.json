            "unique_id": "model.dbt_tennis.fct_player_match",
            "compiled": true,
            "compiled_code": "-- Player x match, with match context and serve/return rates.\n--\n-- Note: this dataset records no winner, so there is no won/lost flag here.\n-- Deriving one needs the 125MB charting-*-points-* files.\nwith stats as (\n    select * from `gary-yiu-001`.`tennis_match`.`stg_match_stats`\n),\n\nmatches as (\n    select * from `gary-yiu-001`.`tennis_match`.`stg_matches`\n)\n\nselect\n    s.match_id,\n    s.player,\n    case when s.player = m.player_1 then m.player_2 else m.player_1 end as opponent,\n    case when s.player = m.player_1 then m.p1_hand else m.p2_hand end   as hand,\n    m.match_date,\n    m.tournament,\n    m.round,\n    m.surface,\n    m.best_of,\n\n    s.serve_pts,\n    s.aces,\n    s.dfs,\n    s.winners,\n    s.unforced,\n\n    -- nullif guards the matches charted with zero of a given point type\n    safe_divide(s.first_in,       nullif(s.serve_pts, 0))  as first_serve_pct,\n    safe_divide(s.first_won,      nullif(s.first_in, 0))   as first_won_pct,\n    safe_divide(s.second_won,     nullif(s.second_in, 0))  as second_won_pct,\n    safe_divide(s.aces,           nullif(s.serve_pts, 0))  as ace_rate,\n    safe_divide(s.dfs,            nullif(s.serve_pts, 0))  as df_rate,\n    safe_divide(s.bp_saved,       nullif(s.bk_pts, 0))     as bp_save_pct,\n    safe_divide(s.return_pts_won, nullif(s.return_pts, 0)) as return_won_pct,\n    safe_divide(s.winners,        nullif(s.unforced, 0))   as winner_ue_ratio\n\nfrom stats as s\ninner join matches as m\n    on s.match_id = m.match_id",
            "relation_name": "`gary-yiu-001`.`tennis_match`.`fct_player_match`",
            "batch_results": null,
            "overload_results": null
